# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Optional API token from @BotFather for live Telegram Bot integration.
# Can also be entered dynamically via the Web UI Bot Setup panel.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# SUPABASE (Print Studio paper inventory):
# Create a free project at https://supabase.com/dashboard, run
# supabase/migrations/001_saved_papers.sql in the SQL editor, then paste
# the project URL and anon key below.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
